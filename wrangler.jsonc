{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-noc-mem",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "new_sqlite_classes": [],
      "tag": "v1"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noc_mem",
      // your own database_id from `npx wrangler d1 create noc_mem`.
      // For local deploy with real ids, copy this file to wrangler.local.jsonc
      // (gitignored) and fill in the values, then deploy with --config wrangler.local.jsonc
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "noc-mem-snapshots"
    }
  ],
  "vars": {
    "MCP_MAX_CONTENT_BYTES": "65536"
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "routes": [
    {
      // your own domain (or remove this block for *.workers.dev).
      // Local deploy: copy to wrangler.local.jsonc (gitignored) and fill in.
      "pattern": "REPLACE_WITH_YOUR_DOMAIN",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
