{
  "name": "cf-noc-mem",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless single-user MCP memory server on Cloudflare Workers (D1 + R2). Fork of nocturne_memory, serverless.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply noc_mem --local",
    "db:migrate:remote": "wrangler d1 migrations apply noc_mem --remote",
    "db:seed": "wrangler d1 execute noc_mem --local --file=test/seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.124.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RealAlexandreAI/cf-noc-mem.git"
  },
  "license": "MIT"
}